extends layout

block head
  script(src='https://cdn.tailwindcss.com')
  link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css', referrerpolicy='no-referrer')
  style.
    body { background: #060913; }
    .grid-glow { background-image: linear-gradient(rgba(37, 99, 235, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(37, 99, 235, .08) 1px, transparent 1px); background-size: 36px 36px; }
    .pulse-ring { animation: pulse-ring 2s cubic-bezier(.4, 0, .6, 1) infinite; }
    @keyframes pulse-ring { 50% { opacity: .35; transform: scale(1.08); } }

block content
 
  main(class='min-h-screen overflow-hidden bg-[#060913] font-sans text-slate-100 selection:bg-cyan-400 selection:text-slate-950')
    section(class='relative isolate')
      div(class='grid-glow absolute inset-0 -z-10 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent_75%)]')
      div(class='absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-blue-600/20 blur-3xl')
      header(class='mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8')
        a(class='flex items-center gap-3', href='#inicio', aria-label=companyName)
          img(class='h-9 w-auto object-contain filter drop-shadow-[0_0_12px_rgba(37,99,235,0.4)]', src='/img/img_logo.png', alt='Logo de Wodex Systems')
          span(class='text-lg font-bold tracking-tight')= companyName
        nav(class='hidden items-center gap-8 text-sm text-slate-300 md:flex', aria-label='Navegación principal')
          a(class='transition hover:text-cyan-300', href='#capacidades') Capacidades
          a(class='transition hover:text-cyan-300', href='#arquitectura') Arquitectura
          a(class='transition hover:text-cyan-300', href='#contacto') Contacto
        div(class='flex items-center gap-2')
          a(class='flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 text-slate-300 transition hover:border-pink-400 hover:text-pink-400', href=instagramUrl, target='_blank', rel='noopener noreferrer', aria-label='Visitar Instagram de Wodex Systems')
            i(class='fa-brands fa-instagram')
          a(class='hidden rounded-lg border border-blue-500/50 bg-blue-600/10 px-4 py-2 text-sm font-semibold text-blue-200 transition hover:bg-blue-600 hover:text-white sm:block', href='mailto:' + email) Escríbenos
      div#inicio(class='mx-auto max-w-7xl px-6 pb-24 pt-14 lg:px-8 lg:pb-32 lg:pt-24')
        div(class='grid items-center gap-16 lg:grid-cols-[1.1fr_.9fr]')
          div
            div(class='mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1.5 text-xs font-medium text-emerald-300')
              span(class='pulse-ring h-2 w-2 rounded-full bg-emerald-400')
              span= status
            p(class='mb-5 text-sm font-semibold uppercase tracking-[.22em] text-cyan-400') Ingeniería digital de misión crítica
            h1(class='max-w-3xl text-5xl font-black leading-[1.05] tracking-tight text-white sm:text-6xl') Plataformas digitales diseñadas para #[span(class='text-transparent bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text') no fallar jamás.]
            p(class='mt-7 max-w-xl text-lg leading-8 text-slate-400') Diseñamos software, automatizaciones e infraestructura cloud que convierten procesos complejos en operaciones confiables y escalables.
            div(class='mt-9 flex flex-wrap gap-4')
              a(class='rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:scale-[1.02]', href='#contacto') Iniciar un proyecto
                i(class='fa-solid fa-arrow-right ml-2')
              a(class='rounded-xl border border-slate-700 bg-slate-900/60 px-5 py-3 text-sm font-bold text-slate-200 transition hover:border-slate-500', href='#capacidades') Explorar capacidades
          div#arquitectura(class='relative rounded-3xl border border-slate-700/80 bg-[#0D1322]/80 p-6 shadow-2xl shadow-blue-950/30 backdrop-blur')
            div(class='mb-8 flex items-center justify-between')
              div
@@ -101,26 +101,26 @@ block content
            div(class='flex items-center gap-3')
              i(class='fa-solid fa-shield-halved text-cyan-400')
              span Información tratada con confidencialidad.
        form(class='rounded-2xl border border-slate-700 bg-[#0D1322] p-6 shadow-xl sm:p-8', action='/contacto', method='post')
          div(class='grid gap-5 sm:grid-cols-2')
            label(class='text-sm font-medium text-slate-300') Nombre
              input(class='mt-2 w-full rounded-lg border border-slate-700 bg-[#060913] px-3 py-2.5 text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400', type='text', name='name', required, placeholder='Su nombre')
            label(class='text-sm font-medium text-slate-300') Empresa
              input(class='mt-2 w-full rounded-lg border border-slate-700 bg-[#060913] px-3 py-2.5 text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400', type='text', name='company', placeholder='Su empresa')
          label(class='mt-5 block text-sm font-medium text-slate-300') Correo corporativo
            input(class='mt-2 w-full rounded-lg border border-slate-700 bg-[#060913] px-3 py-2.5 text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400', type='email', name='email', required, placeholder='nombre@empresa.com')
          label(class='mt-5 block text-sm font-medium text-slate-300') ¿En qué podemos ayudarle?
            textarea(class='mt-2 min-h-28 w-full rounded-lg border border-slate-700 bg-[#060913] px-3 py-2.5 text-white outline-none transition placeholder:text-slate-600 focus:border-cyan-400', name='project', required, placeholder='Describa brevemente su proyecto')
          button(class='mt-6 w-full rounded-lg bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-3 text-sm font-bold text-white transition hover:brightness-110', type='submit') Solicitar cotización
    footer(class='border-t border-slate-800 px-6 py-8')
      div(class='mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 text-sm text-slate-500 sm:flex-row')
        div(class='flex items-center gap-3')
          img(class='h-9 w-9 rounded-lg object-contain', src=logoUrl, alt='Logo de Wodex Systems')
          span © 2026 #{companyName}. Ingeniería para operaciones que no se detienen.
        div(class='flex items-center gap-5')
          a(class='flex items-center gap-2 transition hover:text-pink-400', href=instagramUrl, target='_blank', rel='noopener noreferrer', aria-label='Instagram de Wodex Systems')
            i(class='fa-brands fa-instagram text-base')
            span= instagramHandle
          a(class='flex items-center gap-2 transition hover:text-cyan-300', href='mailto:' + email)
            i(class='fa-solid fa-envelope text-base')
            span= email